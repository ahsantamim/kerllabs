# Public site (apps/web). Copy to apps/web/.env.local for local runs.
# Every NEXT_PUBLIC_ variable is sent to the browser.

# Required in production.
NEXT_PUBLIC_SUPABASE_URL=https://sjshiqtrkicoqwxgfufd.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional. Used only when the publishable key above is unset.
# Legacy JWT anon key. Still public. Never put the service role key here.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin of this site. Used for absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret. Server-only. Shared with the CMS so a publish can refresh this site.
# Generate with: openssl rand -base64 32
# Leave unset locally; the site still revalidates on its own interval.
REVALIDATE_SECRET=
