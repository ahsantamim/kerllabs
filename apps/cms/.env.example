# CMS (apps/cms). Copy to apps/cms/.env.local for local runs.
# Every NEXT_PUBLIC_ variable is sent to the browser.

# Required in production. Same Supabase project as the public site.
NEXT_PUBLIC_SUPABASE_URL=https://sjshiqtrkicoqwxgfufd.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional legacy JWT anon key. Public. Used only when the publishable key is unset.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origins.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CMS_URL=http://localhost:3001

# Secret. Server-only. Same value as the public site's REVALIDATE_SECRET.
# The CMS calls {NEXT_PUBLIC_SITE_URL}/api/revalidate after content changes.
REVALIDATE_SECRET=

# Mock sessions only. Ignored once the Supabase variables above are set.
# CMS_SESSION_SECRET=replace-with-a-unique-random-string-of-at-least-32-characters
