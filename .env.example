# Data source for both apps: "mock" (bundled sample content) or "prisma" (PostgreSQL via @nodal/db)
NODAL_DATA_SOURCE=mock
DATABASE_URL=postgresql://nodal:nodal@localhost:5432/nodal

# Mock CMS sessions; use a unique random value of at least 32 characters outside local development
CMS_SESSION_SECRET=replace-with-a-unique-random-string-of-at-least-32-characters
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CMS_URL=http://localhost:3001
