# Monorepo defaults. Each app also has its own .env.example.
# Production reads the variables from the Vercel project, not from this file.

# "mock" keeps the in-memory sample content (no Supabase required).
# Set the Supabase variables below to use the live project instead.
NEXT_PUBLIC_SUPABASE_URL=https://sjshiqtrkicoqwxgfufd.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CMS_URL=http://localhost:3001

# Secret, shared by both apps. Server-only. Never prefix with NEXT_PUBLIC_.
REVALIDATE_SECRET=

# Legacy Prisma path in packages/db. The apps do not use it once Supabase is set.
# NODAL_DATA_SOURCE=mock
# DATABASE_URL=postgresql://nodal:nodal@localhost:5432/nodal

# Mock CMS cookie signing. Ignored when Supabase env vars are set.
# CMS_SESSION_SECRET=replace-with-a-unique-random-string-of-at-least-32-characters
